<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:custom="clr-namespace:EndfieldChargePlus.Customization"
        x:Class="EndfieldChargePlus.Settings.SettingsWindow"
        Classes="industrial"
        Width="1120" Height="790"
        MinWidth="940" MinHeight="680"
        Title="終末地 靈動島 設定"
        Background="#191D1D"
        WindowStartupLocation="CenterScreen">
  <Window.Resources><ResourceDictionary><ResourceDictionary.MergedDictionaries><ResourceInclude Source="avares://EndfieldChargePlus/Styles/EndfieldBrand.axaml"/></ResourceDictionary.MergedDictionaries></ResourceDictionary></Window.Resources>
  <Grid x:Name="SettingsRoot" RowDefinitions="Auto,*,Auto" ColumnDefinitions="*" Background="{DynamicResource Industrial.Canvas}">
    <Border Grid.Row="0" Background="#202729" Padding="24,18" BorderBrush="#31535A" BorderThickness="0,0,0,1">
      <Grid>
      <WrapPanel x:Name="HeaderCommands" Orientation="Horizontal" HorizontalAlignment="Left">
        <Grid ColumnDefinitions="72,*" Margin="0,0,18,0">
          <Border Width="60" Height="60" HorizontalAlignment="Left">
            <PathIcon x:Name="EndfieldBrandMark" Width="56" Height="56" Foreground="#F0F1EA" Data="{DynamicResource Geo.Endfield.Industries}" IsHitTestVisible="False"/>
          </Border>
          <StackPanel Grid.Column="1" Spacing="4" VerticalAlignment="Center">
            <TextBlock Text="終末地 靈動島" FontSize="20" FontWeight="SemiBold" Foreground="#F0F1EA" LetterSpacing="0.5"/>
            <TextBlock Text="ENDFIELD / DYNAMIC ISLAND" FontSize="12" Foreground="#B4BBB5" LetterSpacing="1"/>
          </StackPanel>
        </Grid>

        <Border Grid.Column="1"
                Width="186" Height="38"
                CornerRadius="7"
                Background="#2B2B2E"
                BorderBrush="#4A4A4F"
                BorderThickness="1"
                VerticalAlignment="Center"
                Margin="16,0,0,0"
                ClipToBounds="True">
          <!--
            Two true 50/50 segments. The previous *,1,* grid left 183 px to be
            split by the star columns, producing two 91.5 px columns and visible
            half-pixel asymmetry. The divider now overlays the exact center so
            both language buttons always receive the same width.
          -->
          <Grid ColumnDefinitions="*,*">
            <Button x:Name="LanguageChineseBtn"
                    Grid.Column="0"
                    Content="繁體中文"
                    Height="36"
                    MinWidth="0"
                    Margin="0"
                    Padding="10,5"
                    CornerRadius="6,0,0,6"
                    HorizontalAlignment="Stretch"
                    VerticalAlignment="Center"
                    HorizontalContentAlignment="Center"
                    VerticalContentAlignment="Center"/>
            <Button x:Name="LanguageEnglishBtn"
                    Grid.Column="1"
                    Content="English"
                    Height="36"
                    MinWidth="0"
                    Margin="0"
                    Padding="10,5"
                    CornerRadius="0,6,6,0"
                    HorizontalAlignment="Stretch"
                    VerticalAlignment="Center"
                    HorizontalContentAlignment="Center"
                    VerticalContentAlignment="Center"/>
            <Border Grid.ColumnSpan="2"
                    Width="1"
                    Background="#55555A"
                    HorizontalAlignment="Center"
                    VerticalAlignment="Stretch"
                    Margin="0,7"
                    IsHitTestVisible="False"/>
          </Grid>
        </Border>

        <StackPanel Grid.Column="2" Orientation="Horizontal" Spacing="8" VerticalAlignment="Center" Margin="10,0,0,0">
          <Button x:Name="OpenSettingsFolderBtn" Content="設定資料夾" Height="38" MinWidth="100" Padding="14,7" HorizontalContentAlignment="Center" VerticalContentAlignment="Center"/>
          <Button x:Name="SaveBtn" Classes="industrialPrimary" Content="儲存並套用" Height="38" MinWidth="108" Padding="16,7" HorizontalContentAlignment="Center" VerticalContentAlignment="Center" Background="#E6E744" Foreground="#171719" FontWeight="SemiBold"/>
        </StackPanel>
      </WrapPanel>
      </Grid>
    </Border>

    <TabControl x:Name="ModuleTabs" Classes="moduleNav" TabStripPlacement="Left" Grid.Row="1" Margin="20,24,20,16" HorizontalAlignment="Left">
      <TabItem Header="AI 助理">
        <ScrollViewer VerticalScrollBarVisibility="Auto">
        <StackPanel Margin="18" Spacing="16">
          <TextBlock Text="靈動島 AI 助理" FontSize="22" Foreground="{DynamicResource Industrial.Info}"/>
          <TextBlock Text="Alt+A 喚出並輸入 · Enter 送出 · Shift+Enter 換行&#10;文字先向左右延伸，再換行向下延伸。長回覆可捲動。&#10;點島的本體標頭可收起；輸入、選取回覆與來源按鈕保持可操作。右鍵可開新對話。" TextWrapping="Wrap" Foreground="#DDDDDD" FontSize="15"/>
          <Button x:Name="OpenAssistantBtn" Classes="industrialPrimary" Content="開啟 AI 靈動島   Alt+A" Background="#E6E744" Foreground="#202020"/>
          <Border Background="#323736" BorderBrush="#626A66" BorderThickness="1" CornerRadius="6" Padding="18">
            <StackPanel Spacing="12">
              <TextBlock Text="對話頭像" FontSize="16" Foreground="{DynamicResource Industrial.Info}"/>
              <TextBlock Text="選擇本機圖片。你的頭像使用黃色外圈，AI 維持青藍色外圈；圖片只保存在這台電腦，不上傳。" TextWrapping="Wrap" Foreground="#C7CDC5"/>
              <WrapPanel>
                <Button x:Name="ChooseUserAvatarBtn" Content="設定我的大頭照" Margin="0,0,8,8"/>
                <Button x:Name="ChooseAiAvatarBtn" Content="設定 AI 大頭照" Margin="0,0,8,8"/>
                <Button x:Name="ResetAvatarsBtn" Content="還原預設頭像" Margin="0,0,8,8"/>
              </WrapPanel>
              <TextBlock x:Name="AvatarNotice" Text="PNG / JPEG / WebP · 自動置中裁成圓形" Foreground="#B4BBB5"/>
            </StackPanel>
          </Border>
          <Border Background="#303634" BorderBrush="#626A66" BorderThickness="1" CornerRadius="10" Padding="18,16">
            <StackPanel Spacing="12">
              <TextBlock Text="Gemini API Key" FontSize="16" Foreground="{DynamicResource Industrial.Info}" FontWeight="SemiBold"/>
              <TextBlock Text="金鑰只加密保存在這台電腦。儲存不扣 AI 次數；不會顯示已儲存的金鑰。" FontSize="13" Foreground="#DDDDDD" TextWrapping="Wrap"/>
              <Grid ColumnDefinitions="*,Auto">
                <TextBox x:Name="GeminiKeyInput" PasswordChar="●" MaxLength="160" Watermark="貼上目前已核對專案的 API Key" AutomationProperties.Name="Gemini API Key" Height="42" Margin="0,0,12,0"/>
                <Button x:Name="SaveGeminiKeyBtn" Classes="industrialPrimary" Grid.Column="1" Content="儲存並套用金鑰" Height="42" IsEnabled="False" Background="#E6E744" Foreground="#202020"/>
              </Grid>
              <TextBlock Text="套用會重新啟動共用 AI 服務。每日額度與免費方案核對紀錄保留；其他專案須先核對方案與額度。" FontSize="13" Foreground="#AAA99C" TextWrapping="Wrap"/>
              <Grid ColumnDefinitions="*,Auto">
                <TextBlock x:Name="GeminiKeyStatusText" Text="正在查詢本機 AI 狀態…" FontSize="13" Foreground="#DDDDDD" TextWrapping="Wrap" VerticalAlignment="Center" Margin="0,0,12,0"/>
                <Button x:Name="RefreshGeminiUsageBtn" Grid.Column="1" Content="查詢用量" Height="36"/>
              </Grid>
            </StackPanel>
          </Border>
          <TextBlock Text="一般聊天使用 Gemini 3.5 Flash Lite；最新資訊先使用 XNG 共用搜尋。&#10;「只搜尋」不呼叫 Gemini。未設定 Key 或用量鎖定時，仍能取得 XNG 搜尋證據。&#10;對話以 Windows 使用者加密保存在本機；收起不會清空，右鍵新對話才重設。&#10;長對話會選取最近內容及相關舊對話節錄；不代表每次都送出全部歷史。" TextWrapping="Wrap" Foreground="#AAA99C" FontSize="13"/>
        </StackPanel>
        </ScrollViewer>
      </TabItem>
      <TabItem x:Name="NotificationTab" Header="Windows 通知">
        <ScrollViewer VerticalScrollBarVisibility="Auto">
          <StackPanel Margin="18" Spacing="16">
            <TextBlock Text="Windows 通知顯示器" FontSize="22" Foreground="{DynamicResource Industrial.Info}"/>
            <TextBlock Text="新通知優先顯示，結束後回到上一頁。點本體固定，再點收起；滑鼠停在島上時不會逾時。&#10;最多保留 10 則、2 分鐘。收起卡片不會刪除 Windows 通知。" TextWrapping="Wrap" Foreground="#DDDDDD" FontSize="15"/>
            <CheckBox x:Name="NotificationsEnabledSwitch" Content="啟用 Windows 通知靈動島" Foreground="White"/>
            <CheckBox x:Name="NotificationHideContentSwitch" Content="隱藏通知內容（僅顯示來源）" Foreground="White"/>
            <TextBlock Text="預覽時間沿用「大小與動畫」的顯示秒數。設定需按「儲存並套用」。&#10;通知只留在本機記憶體，不傳給 Gemini / XNG，不建立通知歷史檔案。啟動或重新啟用時不重播舊通知。" TextWrapping="Wrap" Foreground="#AAAAAA"/>
            <Border Background="#303634" CornerRadius="8" Padding="18"><StackPanel Spacing="12">
              <TextBlock x:Name="NotificationStatusText" Text="正在檢查通知權限…" Foreground="#E6E744" TextWrapping="Wrap"/>
              <WrapPanel>
                <Button x:Name="RequestNotificationAccessBtn" Content="要求通知讀取權限" Margin="0,0,10,8"/>
                <Button x:Name="TestWindowsNotificationBtn" Content="送出 Windows 測試通知" Margin="0,0,10,8"/>
                <Button x:Name="PreviewNotificationBtn" Content="預覽通知介面" Margin="0,0,10,8"/>
              </WrapPanel>
              <TextBlock Text="Windows 的通知或勿擾設定可能影響通知是否產生。測試按鈕會提交本程式的 Windows 通知；通知權限由 Windows 管理。&#10;「預覽通知介面」只產生本機示範卡片，不代表已成功讀取系統通知。" TextWrapping="Wrap" Foreground="#AAAAAA"/>
            </StackPanel></Border>
          </StackPanel>
        </ScrollViewer>
      </TabItem>
      <TabItem x:Name="MusicTab" Header="音樂">
        <ScrollViewer>
          <StackPanel Spacing="16" Margin="18">
            <TextBlock Text="YouTube 音樂播放清單" FontSize="21" FontWeight="SemiBold"/>
            <TextBlock Text="貼上指定播放清單網址。專用背景播放器載入 YouTube 原頁，音樂島可直接控制播放、進度、隨機與重播，不受 Windows 媒體接口缺少功能的限制。" TextWrapping="Wrap"/>
            <TextBox x:Name="MusicPlaylistInput" Watermark="https://www.youtube.com/playlist?list=..." AutomationProperties.Name="YouTube 播放清單網址"/>
            <WrapPanel>
              <Button x:Name="SaveMusicPlaylistBtn" Content="儲存清單" Margin="0,0,8,8"/>
              <Button x:Name="OpenMusicPlaylistBtn" Content="啟動背景清單並顯示音樂島" Margin="0,0,8,8"/>
              <Button x:Name="FollowBrowserMusicBtn" Content="跟隨目前瀏覽器播放" Margin="0,0,8,8"/>
              <Button x:Name="ShowMusicBtn" Content="顯示音樂島 Alt+M" Margin="0,0,8,8"/>
            </WrapPanel>
            <TextBlock x:Name="MusicSettingsNotice" Text="兩種模式獨立：清單只控制專用播放器；網頁只跟隨 Windows 瀏覽器媒體。切到網頁會關閉清單播放器。Alt+M 保留目前模式。" TextWrapping="Wrap"/>
            <TextBlock Text="Alt+M 顯示音樂島；點封面啟動清單，點曲名區收起，右鍵切換播放清單／跟隨瀏覽器模式或設定清單。Alt+A 可切回 AI 對話。重播依序切換：關／整份清單／單曲。YouTube 播放限制與登入要求仍需在原頁處理。" TextWrapping="Wrap" Opacity="0.7"/>
          </StackPanel>
        </ScrollViewer>
      </TabItem>
      <TabItem Header="顯示與位置">
        <ScrollViewer VerticalScrollBarVisibility="Auto">
          <StackPanel Margin="4,12,4,18" Spacing="12">

            <Border Background="#303634" BorderBrush="#626A66" BorderThickness="1" CornerRadius="10" Padding="18,16">
              <StackPanel Spacing="14">
                <Grid ColumnDefinitions="*,Auto">
                  <StackPanel Spacing="3" Margin="0,0,18,0">
                    <TextBlock Text="HUD 總開關" FontSize="14" FontWeight="SemiBold" Foreground="{DynamicResource Industrial.Info}"/>
                    <TextBlock Text="控制 HUD 的全部顯示功能。" FontSize="11" Foreground="#A7AEAA"/>
                  </StackPanel>
                  <ToggleSwitch x:Name="HudEnabledSwitch" Grid.Column="1" VerticalAlignment="Center"/>
                </Grid>

                <Border Height="1" Background="#626A66"/>

                <Grid ColumnDefinitions="*,Auto">
                  <StackPanel Spacing="3" Margin="0,0,18,0">
                    <TextBlock Text="開機啟動" FontSize="12" Foreground="#E7E7E9"/>
                    <TextBlock Text="登入 Windows 後自動啟動 終末地 靈動島。" FontSize="11" Foreground="#7F7F85"/>
                  </StackPanel>
                  <ToggleSwitch x:Name="StartupSwitch" Grid.Column="1" VerticalAlignment="Center"/>
                </Grid>
              </StackPanel>
            </Border>

            <Border Background="#303634" BorderBrush="#626A66" BorderThickness="1" CornerRadius="10" Padding="18,16">
              <StackPanel Spacing="14">
                <TextBlock Text="顯示方式" FontSize="14" FontWeight="SemiBold" Foreground="{DynamicResource Industrial.Info}"/>
                <Grid ColumnDefinitions="*,150,260" RowDefinitions="Auto,Auto">
                  <StackPanel Grid.RowSpan="2" Spacing="2" Margin="0,0,18,0" VerticalAlignment="Center">
                    <TextBlock Text="一直顯示" FontSize="12" Foreground="#E7E7E9"/>
                    <TextBlock Text="開啟：HUD 持續顯示。&#10;關閉：電源插拔顯示電池；滑鼠移到目標螢幕頂部中央可喚出目前方案。" FontSize="13" Foreground="#E6E744" TextWrapping="Wrap" LineHeight="19" Margin="0,3,0,0"/>
                  </StackPanel>
                  <TextBlock Grid.Column="1" Text="常駐狀態" FontSize="11" Foreground="#A7AEAA" Margin="0,0,18,4"/>
                  <TextBlock Grid.Column="2" Text="顯示層級" FontSize="11" Foreground="#A7AEAA" Margin="0,0,0,4"/>
                  <ToggleSwitch x:Name="AlwaysVisibleSwitch" Grid.Row="1" Grid.Column="1" VerticalAlignment="Center" HorizontalAlignment="Left" Margin="0,0,18,0"/>
                  <ComboBox x:Name="PersistentLayerCombo" Grid.Row="1" Grid.Column="2" Height="34"/>
                </Grid>
              </StackPanel>
            </Border>

            <Border Background="#303634" BorderBrush="#626A66" BorderThickness="1" CornerRadius="10" Padding="18,16">
              <Grid ColumnDefinitions="220,*,64" RowDefinitions="Auto,Auto">
                <StackPanel Grid.RowSpan="2" Spacing="3" Margin="0,0,18,0" VerticalAlignment="Center">
                  <TextBlock Text="HUD 不透明度" FontSize="14" FontWeight="SemiBold" Foreground="#E6E744"/>
                  <TextBlock Text="100% 為完全不透明。" FontSize="11" Foreground="#A7AEAA"/>
                </StackPanel>
                <Slider x:Name="HudOpacitySlider" Grid.Column="1" Grid.RowSpan="2" Minimum="10" Maximum="100" TickFrequency="1" VerticalAlignment="Center" Margin="0,0,14,0"/>
                <TextBlock x:Name="HudOpacityValueText" Grid.Column="2" Grid.RowSpan="2" Text="100%" FontSize="13" FontWeight="SemiBold" Foreground="White" VerticalAlignment="Center" HorizontalAlignment="Right"/>
              </Grid>
            </Border>

            <Border Background="#303634" BorderBrush="#626A66" BorderThickness="1" CornerRadius="10" Padding="18,16">
              <StackPanel Spacing="12">
                <TextBlock Text="時鐘" FontSize="14" FontWeight="SemiBold" Foreground="#E6E744"/>
                <Grid ColumnDefinitions="*,Auto,Auto,Auto" VerticalAlignment="Center">
                  <StackPanel Spacing="2" Margin="0,0,18,0">
                    <TextBlock Text="顯示時鐘" FontSize="12" Foreground="#E7E7E9"/>
                    <TextBlock Text="在 HUD 右側顯示目前時間；日期可另外開啟。" FontSize="11" Foreground="#A7AEAA"/>
                  </StackPanel>
                  <ToggleSwitch x:Name="ShowClockSwitch" Grid.Column="1" VerticalAlignment="Center" Margin="0,0,22,0"/>
                  <StackPanel Grid.Column="2" Orientation="Horizontal" Spacing="8" VerticalAlignment="Center" Margin="0,0,22,0">
                    <TextBlock Text="24 小時制" FontSize="11" Foreground="#BDBDC2" VerticalAlignment="Center"/>
                    <ToggleSwitch x:Name="Use24HourSwitch" VerticalAlignment="Center"/>
                  </StackPanel>
                  <StackPanel Grid.Column="3" Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                    <TextBlock Text="顯示日期" FontSize="11" Foreground="#BDBDC2" VerticalAlignment="Center"/>
                    <ToggleSwitch x:Name="ShowDateSwitch" VerticalAlignment="Center"/>
                  </StackPanel>
                </Grid>
              </StackPanel>
            </Border>

            <Border Background="#303634" BorderBrush="#626A66" BorderThickness="1" CornerRadius="10" Padding="18,16">
              <StackPanel Spacing="14">
                <TextBlock Text="位置" FontSize="14" FontWeight="SemiBold" Foreground="#E6E744"/>

                <Grid ColumnDefinitions="*,*">
                  <StackPanel Spacing="4" Margin="0,0,6,0">
                    <TextBlock Text="目標螢幕" FontSize="11" Foreground="#A7AEAA"/>
                    <ComboBox x:Name="MonitorCombo" Height="34"/>
                  </StackPanel>
                  <StackPanel Grid.Column="1" Spacing="4" Margin="6,0,0,0">
                    <TextBlock Text="定位方式" FontSize="11" Foreground="#A7AEAA"/>
                    <ComboBox x:Name="PositionModeCombo" Height="34"/>
                  </StackPanel>
                </Grid>

                <Border x:Name="PresetPositionPanel" Background="#1E1E20" CornerRadius="8" Padding="14">
                  <StackPanel Spacing="10">
                    <Grid ColumnDefinitions="*,150,150">
                      <StackPanel Spacing="4" Margin="0,0,8,0">
                        <TextBlock Text="預設位置" FontSize="11" Foreground="#A7AEAA"/>
                        <ComboBox x:Name="PositionCombo" Height="34"/>
                      </StackPanel>
                      <StackPanel Grid.Column="1" Spacing="4" Margin="8,0">
                        <TextBlock Text="X 微調 / px" FontSize="11" Foreground="#A7AEAA"/>
                        <NumericUpDown x:Name="OffsetXBox" Minimum="-10000" Maximum="10000" Increment="1"/>
                      </StackPanel>
                      <StackPanel Grid.Column="2" Spacing="4" Margin="8,0,0,0">
                        <TextBlock Text="Y 微調 / px" FontSize="11" Foreground="#A7AEAA"/>
                        <NumericUpDown x:Name="OffsetYBox" Minimum="-10000" Maximum="10000" Increment="1"/>
                      </StackPanel>
                    </Grid>
                    <TextBlock Text="X 向右為正，Y 向下為正。" FontSize="11" Foreground="#6F6F74"/>
                  </StackPanel>
                </Border>

                <Border x:Name="CustomPositionPanel" Background="#1E1E20" CornerRadius="8" Padding="14">
                  <Grid ColumnDefinitions="*,*">
                    <StackPanel Spacing="4" Margin="0,0,6,0">
                      <TextBlock Text="X 座標 / px" FontSize="11" Foreground="#A7AEAA"/>
                      <NumericUpDown x:Name="CustomXBox" Minimum="-10000" Maximum="20000" Increment="1"/>
                    </StackPanel>
                    <StackPanel Grid.Column="1" Spacing="4" Margin="6,0,0,0">
                      <TextBlock Text="Y 座標 / px" FontSize="11" Foreground="#A7AEAA"/>
                      <NumericUpDown x:Name="CustomYBox" Minimum="-10000" Maximum="20000" Increment="1"/>
                    </StackPanel>
                  </Grid>
                </Border>
              </StackPanel>
            </Border>

            <Border Background="#303634" BorderBrush="#626A66" BorderThickness="1" CornerRadius="10" Padding="18,16">
              <StackPanel Spacing="14">
                <Grid ColumnDefinitions="*,Auto">
                  <TextBlock Text="尺寸與動畫" FontSize="14" FontWeight="SemiBold" Foreground="#E6E744" VerticalAlignment="Center"/>
                  <Button x:Name="ResetSizeAnimationBtn" Grid.Column="1" Content="還原預設" Height="32" MinWidth="86" Padding="12,5" HorizontalContentAlignment="Center" VerticalContentAlignment="Center"/>
                </Grid>
                <Grid ColumnDefinitions="*,*,*,*,*">
                  <StackPanel Spacing="4" Margin="0,0,5,0">
                    <TextBlock Text="HUD 縮放" FontSize="11" Foreground="#A7AEAA"/>
                    <NumericUpDown x:Name="ScaleBox" Minimum="0.4" Maximum="1.4" Increment="0.05" FormatString="0.00"/>
                  </StackPanel>
                  <StackPanel Grid.Column="1" Spacing="4" Margin="5,0">
                    <TextBlock Text="顯示時間 / 秒" FontSize="11" Foreground="#A7AEAA"/>
                    <NumericUpDown x:Name="DurationBox" Minimum="3" Maximum="10" Increment="0.25" FormatString="0.00"/>
                  </StackPanel>
                  <StackPanel Grid.Column="2" Spacing="4" Margin="5,0">
                    <TextBlock Text="回彈強度" FontSize="11" Foreground="#A7AEAA"/>
                    <NumericUpDown x:Name="BounceBox" Minimum="0" Maximum="0.5" Increment="0.025" FormatString="0.000"/>
                  </StackPanel>
                  <StackPanel Grid.Column="3" Spacing="4" Margin="5,0">
                    <TextBlock Text="波紋強度" FontSize="11" Foreground="#A7AEAA"/>
                    <NumericUpDown x:Name="RippleIntensityBox" Minimum="0" Maximum="2" Increment="0.05" FormatString="0.00"/>
                  </StackPanel>
                  <StackPanel Grid.Column="4" Spacing="4" Margin="5,0,0,0">
                    <TextBlock Text="波紋幅度" FontSize="11" Foreground="#A7AEAA"/>
                    <NumericUpDown x:Name="RippleSpreadBox" Minimum="0.5" Maximum="1.5" Increment="0.05" FormatString="0.00"/>
                  </StackPanel>
                </Grid>
              </StackPanel>
            </Border>


          </StackPanel>
        </ScrollViewer>
      </TabItem>

      <TabItem Header="HUD 內容與資料">
        <custom:HudCustomizerView x:Name="Customizer" Margin="4,12,4,4"/>
      </TabItem>

      <TabItem Header="關於">
        <ScrollViewer VerticalScrollBarVisibility="Auto">
          <StackPanel Margin="4,12,4,18" Spacing="12">
            <Border Background="#303634" BorderBrush="#626A66" BorderThickness="1" CornerRadius="10" Padding="24,22">
              <Grid ColumnDefinitions="96,*,320">
                <Border Width="76" Height="76" CornerRadius="18" Background="#1E1E20" BorderBrush="#39393D" BorderThickness="1" VerticalAlignment="Top">
                  <Image Source="avares://EndfieldChargePlus/Assets/tray_bolt.png" Width="66" Height="66" Stretch="Uniform" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                </Border>

                <StackPanel Grid.Column="1" Spacing="5" Margin="18,0,24,0">
                  <TextBlock Text="終末地 靈動島" FontSize="24" FontWeight="Bold" Foreground="White"/>
                  <TextBlock Text="終末地風格狀態列 HUD" FontSize="14" Foreground="#D2D2D6"/>
                  <TextBlock x:Name="AboutArchitectureText" Text="Windows · x64" FontSize="12" Foreground="#B4BBB5" Margin="0,1,0,0"/>
                  <StackPanel Orientation="Horizontal" Spacing="18" Margin="0,7,0,0">
                    <TextBlock x:Name="AboutVersionText" Text="v0.22.0" FontSize="13" FontWeight="SemiBold" Foreground="#E6E744"/>
                    <TextBlock Text="建置日期  2026.10.04" FontSize="13" Foreground="#D2D2D6"/>
                  </StackPanel>
                </StackPanel>

                <Border Grid.Column="2" Background="#1E1E20" BorderBrush="#626A66" BorderThickness="1" CornerRadius="8" Padding="14,12">
                  <Grid ColumnDefinitions="96,*" VerticalAlignment="Center">
                    <Button x:Name="CheckUpdateBtn" Classes="industrialPrimary"
                            Grid.Column="0"
                            Content="檢查更新"
                            Width="84"
                            Height="36"
                            HorizontalAlignment="Left"
                            VerticalAlignment="Center"
                            HorizontalContentAlignment="Center"
                            VerticalContentAlignment="Center"
                            Background="#E6E744"
                            Foreground="#171719"
                            FontWeight="SemiBold"/>
                    <StackPanel Grid.Column="1" Spacing="6" VerticalAlignment="Center">
                      <TextBlock x:Name="UpdateCurrentVersionText" Text="目前版本：v0.22.0" FontSize="12" Foreground="#D2D2D6"/>
                      <TextBlock x:Name="UpdateLatestVersionText" Text="最新版本：尚未取得" FontSize="12" Foreground="#D2D2D6"/>
                      <TextBlock x:Name="UpdateStatusText" Text="狀態：尚未檢查" FontSize="12" Foreground="#E6E744" TextWrapping="Wrap"/>
                    </StackPanel>
                  </Grid>
                </Border>
              </Grid>
            </Border>

            <Border Background="#303634" BorderBrush="#626A66" BorderThickness="1" CornerRadius="10" Padding="20,18">
              <StackPanel Spacing="12">
                <TextBlock Text="專案與授權" FontSize="14" FontWeight="SemiBold" Foreground="#E6E744"/>
                <TextBlock Text="圖標：Yue-plus/endfield_icons · MIT · © 2023 Yue_plus" TextWrapping="Wrap" FontSize="12" Foreground="#C7CDC5"/>
                <Grid ColumnDefinitions="128,*,80" RowDefinitions="Auto,Auto,Auto,Auto">
                  <TextBlock Text="開源授權" FontSize="12" Foreground="#B4BBB5" VerticalAlignment="Center" Margin="0,0,0,10"/>
                  <TextBlock Grid.Column="1" Text="MIT" FontSize="13" Foreground="White" VerticalAlignment="Center" Margin="0,0,0,10"/>

                  <TextBlock Grid.Row="1" Text="本專案 GitHub" FontSize="12" Foreground="#B4BBB5" VerticalAlignment="Center" Margin="0,0,0,10"/>
                  <TextBlock Grid.Row="1" Grid.Column="1" Text="github.com/OverGreen996/Endfield-Dynamic-Island" FontSize="12" Foreground="#8DE1ED" TextWrapping="Wrap" VerticalAlignment="Center" Margin="0,0,0,10"/>
                  <Button x:Name="OpenProjectGithubBtn" Grid.Row="1" Grid.Column="2" Content="開啟" Height="30" MinWidth="66" Padding="10,4" Margin="8,0,0,10" HorizontalContentAlignment="Center" VerticalContentAlignment="Center"/>

                  <TextBlock Grid.Row="2" Text="原專案 GitHub" FontSize="12" Foreground="#B4BBB5" VerticalAlignment="Center" Margin="0,0,0,10"/>
                  <TextBlock Grid.Row="2" Grid.Column="1" Text="github.com/QinAnze/zmd-charge" FontSize="13" Foreground="White" VerticalAlignment="Center" Margin="0,0,0,10"/>
                  <Button x:Name="OpenUpstreamBtn" Grid.Row="2" Grid.Column="2" Content="開啟" Height="30" MinWidth="66" Padding="10,4" Margin="8,0,0,10" HorizontalContentAlignment="Center" VerticalContentAlignment="Center"/>

                  <TextBlock Grid.Row="3" Text="專案網站" FontSize="12" Foreground="#B4BBB5" VerticalAlignment="Center"/>
                  <TextBlock Grid.Row="3" Grid.Column="1" Text="GitHub Releases" FontSize="13" Foreground="White" VerticalAlignment="Center"/>
                  <Button x:Name="OpenWebsiteBtn" Grid.Row="3" Grid.Column="2" Content="開啟" Height="30" MinWidth="66" Padding="10,4" Margin="8,0,0,0" HorizontalContentAlignment="Center" VerticalContentAlignment="Center"/>
                </Grid>
              </StackPanel>
            </Border>

            <Border Background="#303634" BorderBrush="#626A66" BorderThickness="1" CornerRadius="10" Padding="20,18">
              <StackPanel Spacing="12">
                <TextBlock Text="設定與維護" FontSize="14" FontWeight="SemiBold" Foreground="#E6E744"/>
                <WrapPanel Orientation="Horizontal">
                  <Button x:Name="ExportSettingsBtn" Content="匯出設定" Height="34" MinWidth="92" Padding="14,5" Margin="0,0,8,8" HorizontalContentAlignment="Center" VerticalContentAlignment="Center"/>
                  <Button x:Name="ImportSettingsBtn" Content="匯入設定" Height="34" MinWidth="92" Padding="14,5" Margin="0,0,8,8" HorizontalContentAlignment="Center" VerticalContentAlignment="Center"/>
                  <Button x:Name="BackupSettingsBtn" Content="備份目前設定" Height="34" MinWidth="112" Padding="14,5" Margin="0,0,8,8" HorizontalContentAlignment="Center" VerticalContentAlignment="Center"/>
                  <Button x:Name="OpenLogsFolderBtn" Content="紀錄資料夾" Height="34" MinWidth="98" Padding="14,5" Margin="0,0,8,8" HorizontalContentAlignment="Center" VerticalContentAlignment="Center"/>
                  <Button x:Name="ResetAllSettingsBtn" Content="還原全部預設" Height="34" MinWidth="112" Padding="14,5" Margin="0,0,0,8" HorizontalContentAlignment="Center" VerticalContentAlignment="Center"/>
                </WrapPanel>
                <TextBlock x:Name="MaintenanceStatusText" Text="" FontSize="12" Foreground="#E6E744" TextWrapping="Wrap"/>
              </StackPanel>
            </Border>

            <TextBlock Text="© 2026 GlacierGlimmer_冰川雪貓" FontSize="13" Foreground="#7F7F85" HorizontalAlignment="Center" Margin="0,8,0,0"/>
          </StackPanel>
        </ScrollViewer>
      </TabItem>
    </TabControl>
    <Border Grid.Row="2" Padding="24,10" BorderBrush="#4D554C" BorderThickness="0,1,0,0">
      <Grid ColumnDefinitions="*,Auto">
        <TextBlock Text="本機工作站 · 搜尋 / 音樂 / 提醒" FontSize="11" Foreground="#B4BBB5"/>
        <TextBlock Grid.Column="1" Text="/// ENDFIELD INDUSTRIES" FontSize="10" LetterSpacing="1.5" Foreground="#E6E744"/>
      </Grid>
    </Border>
  </Grid>
</Window>
