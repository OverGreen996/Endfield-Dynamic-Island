<Styles xmlns="https://github.com/avaloniaui" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
  <Styles.Resources>
    <Color x:Key="Industrial.Graphite">#191D1D</Color>
    <Color x:Key="Industrial.Slate">#323736</Color>
    <Color x:Key="Industrial.Yellow">#E6E744</Color>
    <SolidColorBrush x:Key="Industrial.Cyan" Color="#13C8EB"/>
    <SolidColorBrush x:Key="Industrial.Info" Color="#8DE1ED"/>
    <SolidColorBrush x:Key="Industrial.Canvas" Color="{StaticResource Industrial.Graphite}"/>
    <SolidColorBrush x:Key="Industrial.Panel" Color="{StaticResource Industrial.Slate}"/>
    <SolidColorBrush x:Key="Industrial.Accent" Color="{StaticResource Industrial.Yellow}"/>
    <SolidColorBrush x:Key="Industrial.Line" Color="#626A66"/>
    <SolidColorBrush x:Key="Industrial.Text" Color="#F0F1EA"/>
    <SolidColorBrush x:Key="Industrial.Muted" Color="#B4BBB5"/>
  </Styles.Resources>
  <Style Selector="Window.industrial"><Setter Property="Background" Value="{DynamicResource Industrial.Canvas}"/><Setter Property="FontFamily" Value="Segoe UI, Microsoft JhengHei UI"/></Style>
  <Style Selector="Window.industrial Button"><Setter Property="CornerRadius" Value="4"/><Setter Property="Background" Value="{DynamicResource Industrial.Panel}"/><Setter Property="BorderBrush" Value="{DynamicResource Industrial.Line}"/><Setter Property="Padding" Value="14,9"/><Setter Property="Cursor" Value="Hand"/></Style>
  <Style Selector="Window.industrial Button:pointerover /template/ ContentPresenter"><Setter Property="Background" Value="#314248"/><Setter Property="Foreground" Value="{DynamicResource Industrial.Text}"/><Setter Property="BorderBrush" Value="{DynamicResource Industrial.Cyan}"/></Style>
  <Style Selector="Window.industrial Button.industrialPrimary:pointerover /template/ ContentPresenter"><Setter Property="Background" Value="#F0F16A"/><Setter Property="Foreground" Value="#171719"/></Style>
  <Style Selector="Window.industrial Button:focus-visible /template/ ContentPresenter"><Setter Property="BorderBrush" Value="{DynamicResource Industrial.Cyan}"/><Setter Property="BorderThickness" Value="2"/></Style>
  <Style Selector="Window.industrial TextBox"><Setter Property="CornerRadius" Value="4"/></Style>
  <Style Selector="Window.industrial ComboBox"><Setter Property="CornerRadius" Value="4"/></Style>
  <Style Selector="TabControl.moduleNav &gt; TabItem"><Setter Property="MinWidth" Value="160"/><Setter Property="MinHeight" Value="54"/><Setter Property="FontSize" Value="13"/><Setter Property="HorizontalContentAlignment" Value="Left"/><Setter Property="Margin" Value="0,0,10,8"/><Setter Property="Background" Value="#303634"/><Setter Property="Foreground" Value="#E6E9E2"/><Setter Property="BorderBrush" Value="#59615B"/><Setter Property="BorderThickness" Value="1"/></Style>
  <Style Selector="TabControl.moduleNav &gt; TabItem">
    <Setter Property="Padding" Value="18,10"/>
    <Setter Property="Template"><ControlTemplate>
      <Border Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}" Padding="{TemplateBinding Padding}">
        <ContentPresenter Name="PART_HeaderPresenter" Content="{TemplateBinding Header}" ContentTemplate="{TemplateBinding HeaderTemplate}" HorizontalContentAlignment="{TemplateBinding HorizontalContentAlignment}" VerticalContentAlignment="Center"/>
      </Border>
    </ControlTemplate></Setter>
  </Style>
  <Style Selector="TabControl.moduleNav &gt; TabItem:selected"><Setter Property="Background" Value="#14373F"/><Setter Property="Foreground" Value="#8DE1ED"/><Setter Property="BorderBrush" Value="#13C8EB"/></Style>
  <Style Selector="TabControl.moduleNav &gt; TabItem:pointerover"><Setter Property="BorderBrush" Value="#13C8EB"/></Style>
  <Style Selector="TabControl.moduleNav.compact &gt; TabItem"><Setter Property="MinWidth" Value="54"/><Setter Property="MaxWidth" Value="60"/><Setter Property="Padding" Value="12,8"/></Style>
</Styles>
