<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        x:Class="EndfieldChargePlus.Views.HudPinWindow"
        Width="48" Height="26"
        SystemDecorations="None"
        Background="Transparent"
        Topmost="True"
        ShowInTaskbar="False"
        ShowActivated="False"
        CanResize="False"
        WindowStartupLocation="Manual">
  <Border x:Name="PinShell"
          CornerRadius="5"
          Background="#F02A292B"
          BorderBrush="#7071766B"
          BorderThickness="1"
          Padding="1">
    <Button x:Name="PinButton"
            Content="PIN"
            Padding="7,2"
            Background="Transparent"
            BorderThickness="0"
            Foreground="#FFD8D9C7"
            FontFamily="Consolas, Cascadia Mono, monospace"
            FontSize="9"
            FontWeight="SemiBold"
            HorizontalContentAlignment="Center"
            VerticalContentAlignment="Center"/>
  </Border>
</Window>