<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        mc:Ignorable="d" d:DesignWidth="1200" d:DesignHeight="160"
        x:Class="EndfieldChargePlus.Views.HudWindow"
        Width="1200" Height="160"
        Title="終末地 靈動島"
        SystemDecorations="None"
        Background="Transparent"
        Topmost="True"
        ShowInTaskbar="False"
        ShowActivated="False"
        CanResize="False"
        Focusable="False"
        WindowStartupLocation="Manual">
  <Window.Resources>
    <ResourceDictionary>
      <ResourceDictionary.MergedDictionaries>
        <ResourceInclude Source="avares://EndfieldChargePlus/Styles/Geometries.axaml"/>
        <ResourceInclude Source="avares://EndfieldChargePlus/Styles/HudTheme.axaml"/>
        <ResourceInclude Source="avares://EndfieldChargePlus/Styles/EndfieldBrand.axaml"/>
      </ResourceDictionary.MergedDictionaries>
    </ResourceDictionary>
  </Window.Resources>

  <Grid x:Name="Root" Width="1200" Height="100" VerticalAlignment="Center" IsHitTestVisible="False">
    <Grid x:Name="GlobalScale"
          HorizontalAlignment="Center" VerticalAlignment="Center"
          RenderTransformOrigin="50%,50%">
      <Grid.RenderTransform>
        <ScaleTransform ScaleX="0.8" ScaleY="0.8"/>
      </Grid.RenderTransform>

      <Grid x:Name="ScaleHost"
            HorizontalAlignment="Center" VerticalAlignment="Center"
            RenderTransformOrigin="50%,50%">
        <Grid.RenderTransform>
          <ScaleTransform ScaleX="1" ScaleY="1"/>
        </Grid.RenderTransform>

        <Border x:Name="Pill"
                Width="560" Height="60"
                CornerRadius="30"
                Background="#FF312F30"
                ClipToBounds="True"
                HorizontalAlignment="Center"
                VerticalAlignment="Center"
                Opacity="0">
          <Border.RenderTransform>
            <ScaleTransform ScaleX="0.6" ScaleY="0.6"/>
          </Border.RenderTransform>

          <Grid>
          <Path x:Name="OverviewEdge" Width="56" Height="56" HorizontalAlignment="Right" VerticalAlignment="Bottom"
                Data="M55.75,0 A55.75,55.75 0 0 1 0,55.75 L0,52.75 A52.75,52.75 0 0 0 52.75,0 Z"
                Fill="#E6E744" IsVisible="False" IsHitTestVisible="False"/>
          <Grid x:Name="RippleHost"
                HorizontalAlignment="Center" VerticalAlignment="Center"
                IsHitTestVisible="False">
            <Grid.RenderTransform>
              <TranslateTransform X="0"/>
            </Grid.RenderTransform>

            <Grid x:Name="RippleInnerHost" HorizontalAlignment="Center" VerticalAlignment="Center">
              <Grid.RenderTransform><TranslateTransform Y="16"/></Grid.RenderTransform>
              <Ellipse x:Name="RippleInner" Width="160" Height="160" Fill="#FF656363"
                       HorizontalAlignment="Center" VerticalAlignment="Center"
                       Opacity="0" RenderTransformOrigin="50%,50%">
                <Ellipse.RenderTransform><ScaleTransform ScaleX="0" ScaleY="0"/></Ellipse.RenderTransform>
              </Ellipse>
            </Grid>

            <Grid x:Name="RippleMidHost" HorizontalAlignment="Center" VerticalAlignment="Center">
              <Grid.RenderTransform><TranslateTransform Y="16"/></Grid.RenderTransform>
              <Ellipse x:Name="RippleMid" Width="220" Height="220" Stroke="#FF656363" StrokeThickness="5"
                       HorizontalAlignment="Center" VerticalAlignment="Center"
                       Opacity="0" RenderTransformOrigin="50%,50%">
                <Ellipse.RenderTransform><ScaleTransform ScaleX="0" ScaleY="0"/></Ellipse.RenderTransform>
              </Ellipse>
            </Grid>

            <Grid x:Name="RippleOuterHost" HorizontalAlignment="Center" VerticalAlignment="Center">
              <Grid.RenderTransform><TranslateTransform Y="16"/></Grid.RenderTransform>
              <Ellipse x:Name="RippleOuter" Width="280" Height="280" Stroke="#FF656363" StrokeThickness="3.5"
                       HorizontalAlignment="Center" VerticalAlignment="Center"
                       Opacity="0" RenderTransformOrigin="50%,50%">
                <Ellipse.RenderTransform><ScaleTransform ScaleX="0" ScaleY="0"/></Ellipse.RenderTransform>
              </Ellipse>
            </Grid>
          </Grid>
          </Grid>
        </Border>

        <Grid x:Name="BoltIcon"
              Width="32" Height="32"
              HorizontalAlignment="Center" VerticalAlignment="Center"
              Opacity="0">
          <Grid.RenderTransform>
            <TransformGroup>
              <ScaleTransform ScaleX="0.4" ScaleY="0.4"/>
              <TranslateTransform X="0"/>
            </TransformGroup>
          </Grid.RenderTransform>

          <Grid x:Name="CircleForm">
            <Ellipse Width="32" Height="32" Fill="#FFE9E7E4"/>
            <Path x:Name="CircleGlyph" Width="18" Height="18" Stretch="Uniform" HorizontalAlignment="Center" VerticalAlignment="Center"
                      Data="{DynamicResource Geo.Bolt}"
                      Fill="#FF141313"/>
          </Grid>

          <Grid x:Name="SquareForm" Opacity="0">
            <Border Width="18" Height="18" CornerRadius="4.5"
                    Background="#FFE9E7E4"
                    HorizontalAlignment="Center" VerticalAlignment="Center">
              <Path x:Name="SquareGlyph" Width="12" Height="12" Stretch="Uniform" HorizontalAlignment="Center" VerticalAlignment="Center"
                        Data="{DynamicResource Geo.Bolt}"
                        Fill="#FF141313"/>
            </Border>
          </Grid>
        </Grid>

        <StackPanel x:Name="TitleHost"
                    Orientation="Vertical" Spacing="2"
                    HorizontalAlignment="Center" VerticalAlignment="Center"
                    Opacity="0">
          <StackPanel.RenderTransform><TranslateTransform X="0"/></StackPanel.RenderTransform>
          <TextBlock x:Name="TagLineText"
                     Text="/// SYSTEM MONITOR"
                     FontFamily="{DynamicResource Hud.FontFamilyNumeric}"
                     FontSize="9" FontWeight="Medium" LetterSpacing="2"
                     HorizontalAlignment="Center" Foreground="White" Opacity="0.40"/>
          <TextBlock x:Name="TitleText"
                     Text="系統狀態"
                     FontFamily="{DynamicResource Hud.FontFamily}"
                     FontSize="26" FontWeight="Bold" LetterSpacing="2"
                     HorizontalAlignment="Center" Foreground="White"/>
        </StackPanel>

        <Grid x:Name="NumHost"
              Width="560"
              HorizontalAlignment="Center" VerticalAlignment="Center"
              Opacity="0">
          <Grid.RenderTransform><TranslateTransform X="0"/></Grid.RenderTransform>
          <Grid.ColumnDefinitions>
            <ColumnDefinition Width="32"/>
            <ColumnDefinition Width="18"/>
            <ColumnDefinition Width="14"/>
            <ColumnDefinition Width="Auto"/>
            <ColumnDefinition Width="*"/>
            <ColumnDefinition Width="Auto"/>
            <ColumnDefinition Width="14"/>
            <ColumnDefinition Width="Auto"/>
            <ColumnDefinition Width="5"/>
          </Grid.ColumnDefinitions>

          <StackPanel x:Name="StandardPrimary" Grid.Column="3" Orientation="Horizontal" VerticalAlignment="Center" Spacing="2">
            <TextBlock x:Name="PrimaryText"
                       Text="0"
                       FontFamily="{DynamicResource Hud.FontFamilyNumeric}"
                       FontSize="26" FontWeight="Medium" Foreground="White"/>
            <TextBlock x:Name="SecondaryText"
                       Text="/0"
                       FontFamily="{DynamicResource Hud.FontFamilyNumeric}"
                       FontSize="14" FontWeight="Medium"
                       Foreground="White" Opacity="0.55" VerticalAlignment="Center"/>
          </StackPanel>

          <StackPanel x:Name="StandardRight" Grid.Column="5" Orientation="Horizontal" VerticalAlignment="Center" Spacing="1">
            <TextBlock x:Name="RightText"
                       Text="0"
                       FontFamily="{DynamicResource Hud.FontFamilyNumeric}"
                       FontSize="22" FontWeight="Medium" Foreground="White"/>
            <TextBlock x:Name="RightSuffixText"
                       Text="%"
                       FontFamily="{DynamicResource Hud.FontFamilyNumeric}"
                       FontSize="13" FontWeight="Medium"
                       Foreground="White" Opacity="0.55" VerticalAlignment="Center"/>
          </StackPanel>

          <Grid x:Name="Badge" Grid.Column="7" Width="46" Height="46" VerticalAlignment="Center">
            <Ellipse Width="46" Height="46" Fill="#FF262425"/>
            <Path x:Name="BadgeArc"
                  Width="46" Height="46"
                  HorizontalAlignment="Center" VerticalAlignment="Center"
                  Stretch="None"
                  Stroke="#FFC6CA4C" StrokeThickness="4.5" StrokeLineCap="Round"/>

            <Grid x:Name="BadgeLaptop" Width="24" Height="17"
                  VerticalAlignment="Center" HorizontalAlignment="Center">
              <Border x:Name="LaptopScreen"
                      Width="17" Height="11.5" CornerRadius="1.5"
                      BorderBrush="#FFC6CA4C" BorderThickness="2"
                      VerticalAlignment="Top" HorizontalAlignment="Center"/>
              <Border x:Name="LaptopBase"
                      Width="24" Height="3" CornerRadius="1.5"
                      Background="#FFC6CA4C"
                      VerticalAlignment="Bottom" HorizontalAlignment="Center"/>
            </Grid>
            <Border x:Name="BadgeElectrode" Width="9" Height="3" CornerRadius="1,1,0,0"
                    Background="#FFC6CA4C"
                    HorizontalAlignment="Center" VerticalAlignment="Center"
                    Margin="0,-14,0,0"/>

            <Path x:Name="BadgeGlyph"
                      Width="21" Height="21"
                      HorizontalAlignment="Center" VerticalAlignment="Center"
                      Fill="#FFC6CA4C" Stretch="Uniform"
                      IsVisible="False"/>
          </Grid>
          <Border x:Name="OverviewIdentity" Grid.ColumnSpan="9" Width="72" Height="80" CornerRadius="14"
                  HorizontalAlignment="Left" VerticalAlignment="Center" Margin="18,0,0,0" Background="#252927" IsVisible="False">
            <Grid>
              <PathIcon Width="56" Height="56" Foreground="#E9ECE4" Data="{DynamicResource Geo.Endfield.Industries}" IsHitTestVisible="False"/>
              <Border Width="2" Height="42" Background="#E6E744" HorizontalAlignment="Left" Margin="0,12,0,12"/>
            </Grid>
          </Border>
          <StackPanel x:Name="OverviewHeading" Grid.ColumnSpan="9" HorizontalAlignment="Left" VerticalAlignment="Top" Margin="112,10,0,0" Spacing="3" IsVisible="False">
            <TextBlock Text="SYSTEM PERFORMANCE" FontSize="16" FontWeight="SemiBold" LetterSpacing="1" Foreground="#F3F4ED"/>
            <TextBlock Text="ENDFIELD / TELEMETRY" FontFamily="Consolas" FontSize="9" LetterSpacing="1.4" Foreground="#C1C6BB"/>
          </StackPanel>
          <Grid x:Name="OverviewHost" Grid.ColumnSpan="9" Margin="64,0,88,0" VerticalAlignment="Center" ColumnDefinitions="*,*,*,*" Height="46" IsVisible="False"/>
        </Grid>

        <Grid x:Name="ClockHost"
              Width="560" Height="60"
              HorizontalAlignment="Center" VerticalAlignment="Center"
              IsHitTestVisible="False"
              Opacity="0">
          <Border x:Name="OverviewClockDivider" Width="1" Height="32" Background="#596057"
                  HorizontalAlignment="Right" VerticalAlignment="Center" Margin="0,0,128,0" IsVisible="False"/>
          <TextBlock x:Name="ClockText"
                     Text="00:00"
                     HorizontalAlignment="Right" VerticalAlignment="Top"
                     Margin="0,5,70,0"
                     FontFamily="Consolas, Cascadia Mono, monospace"
                     FontSize="10" FontWeight="SemiBold"
                     Foreground="#FFD8D9C7" Opacity="0.82"/>
          <TextBlock x:Name="DateText"
                     Text="2026/10/03"
                     HorizontalAlignment="Right" VerticalAlignment="Bottom"
                     Margin="0,0,70,5"
                     FontFamily="Consolas, Cascadia Mono, monospace"
                     FontSize="8" FontWeight="Medium"
                     Foreground="#FFA4A69A" Opacity="0.62"/>
        </Grid>
      </Grid>
    </Grid>
  </Grid>
</Window>
